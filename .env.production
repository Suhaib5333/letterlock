# Production env, committed on purpose.
#
# Only PUBLIC values live here. VITE_API_URL is the base URL of our own backend
# (LAUNCH_PLAN Phase 2: NestJS API on the VPS behind Traefik). It is not a
# secret: every request the browser makes already shows it, and nothing it
# serves is readable without a user's own token (JWT access token + refresh
# token issued by the API and checked on every route, no anon key involved).
#
# NEVER put JWT_SECRET, DATABASE_URL, Resend/Google/Apple secrets here; those
# live in the API's own environment on the server, never in the client bundle.

VITE_API_URL=https://api.letterlock.raltech.dev

# Web "Sign in with Apple" (Apple 4.8). Leave empty until the Services ID exists
# (Apple Developer > Identifiers > Services IDs; return URL
# https://letterlock.raltech.dev/auth/callback). Empty = the button is hidden.
VITE_APPLE_SERVICES_ID=

# Crash reporting (LAUNCH_PLAN Phase 7). Public by design (a DSN only accepts
# events, it cannot read them). Empty until the Sentry project exists.
VITE_SENTRY_DSN=

# AdMob ad UNIT ids (LAUNCH_PLAN Phase 4). Public: they are visible in every ad
# request the app makes. The APP ids live in the native projects instead
# (android strings.xml `admob_app_id`, ios Info.plist `GADApplicationIdentifier`).
# All three must be set for a platform or a production build shows NO ads at all,
# never Google's test ads (Apple 2.1). Created 2026-09-14.
VITE_ADMOB_BANNER_ANDROID=ca-app-pub-7138183978612183/5264869696
VITE_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-7138183978612183/6388222989
VITE_ADMOB_REWARDED_ANDROID=ca-app-pub-7138183978612183/2448977972
VITE_ADMOB_BANNER_IOS=ca-app-pub-7138183978612183/5815921071
VITE_ADMOB_INTERSTITIAL_IOS=ca-app-pub-7138183978612183/9887028028
VITE_ADMOB_REWARDED_IOS=ca-app-pub-7138183978612183/1984487278
