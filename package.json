{
  "name": "letterlock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Letterlock — a fair, gorgeous reinvention of TV's Blockbusters on a Game-of-Hex board.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "db:link": "npx -y supabase@^2 link --project-ref lkudntyvngwwlzuciocd",
    "db:push": "npx -y supabase@^2 db push",
    "db:pull": "npx -y supabase@^2 db pull",
    "db:diff": "npx -y supabase@^2 db diff",
    "db:status": "npx -y supabase@^2 migration list"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.108.2",
    "@types/qrcode": "^1.5.6",
    "canvas-confetti": "^1.9.3",
    "motion": "^11.18.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@cloudflare/workers-types": "^4.20260620.1",
    "@playwright/test": "^1.49.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.19.20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "sharp": "^0.35.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
