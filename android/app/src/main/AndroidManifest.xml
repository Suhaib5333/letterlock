<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- One APK/AAB for phones, tablets AND Android TV / Google TV (LAUNCH_PLAN.md
         Phase 3b). Neither leanback nor a touchscreen is *required*, so the Play
         Store offers the app to every form factor. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- screenOrientation is deliberately unlocked: the web app decides
             (the phone controller locks itself to portrait through the
             ScreenOrientation plugin; the board follows the device). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV home screen (Leanback) launcher entry. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- App Links: https://letterlock.raltech.dev/join/CODE opens the app
                 (verified against /.well-known/assetlinks.json on the domain). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="letterlock.raltech.dev" android:pathPrefix="/join/" />
            </intent-filter>
        </activity>

        <!-- AdMob APP id (LAUNCH_PLAN Phase 4). The value lives in res/values/strings.xml
             as `admob_app_id`. TODO(Suhaib): replace Google's public TEST app id there
             with the real one from the AdMob console (ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY)
             before the first store build. Unit ids are build-time env (VITE_ADMOB_*). -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="@string/admob_app_id" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @capacitor/network -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- @capacitor/haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- @capacitor-community/keep-awake -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
