# Env / secrets
.env
.env.*
!.env.example
# .env.production is committed on purpose — the only values it holds are the
# Supabase ANON key + URL, which are public-safe by design (already in the
# client bundle anyone can view-source) and enforced via RLS server-side.
# This is what lets the Cloudflare build pick them up without dashboard env
# wiring. NEVER add a service_role key or DB password here.
!.env.production

verify-shots/
.env.local

# Local secret notes (never committed)
*.secret.md

# Playwright MCP scratch (screenshots/snapshots)
.playwright-mcp/

# VPS / DB credentials for the Phase-2 backend (LAUNCH_PLAN.md §2c). Names only
# live in the plan; values live here and in GitHub Actions secrets. Never commit.
infra/vps-creds
infra/db-creds
infra/.kvm-known-hosts
infra/*.backup
dist-e2e-*/
