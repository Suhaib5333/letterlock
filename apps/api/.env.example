# Letterlock API environment (LAUNCH_PLAN §2c). Copy to .env for local dev.
NODE_ENV=development
PORT=3100
# Local: docker run -d --name ll-pg -e POSTGRES_PASSWORD=ll -p 55432:5432 postgres:16
DATABASE_URL=postgresql://postgres:ll@localhost:55432/postgres
JWT_SECRET=change-me-openssl-rand-base64-48
PUBLIC_URL=http://localhost:3100
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Empty RESEND_API_KEY = dev mode: OTP codes are logged/captured, never emailed.
RESEND_API_KEY=
MAIL_FROM=Letterlock <no-reply@raltech.dev>
MAIL_REPLY_TO=
# Header x-qa-token for the QA cleanup workflow and the OTA release PATCH /app-config.
QA_ADMIN_TOKEN=
# Google sign-in (web redirect + native id tokens). Callback: $PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_NATIVE_CLIENT_IDS=
# Sign in with Apple: the Services ID (web) / bundle id (native) accepted as audience.
APPLE_CLIENT_ID=
# RevenueCat webhook shared secret (Authorization header value configured in RevenueCat).
REVENUECAT_WEBHOOK_SECRET=
# OTA bundles served at GET /bundles/<version>.zip
BUNDLES_DIR=./bundles
