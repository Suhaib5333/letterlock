{
  "rootDir": "..",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json", "isolatedModules": true }] },
  "setupFiles": ["<rootDir>/test/env.ts"],
  "testTimeout": 30000
}
